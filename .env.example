# ==============================================================================
# SECRETS CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your API credentials.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# Apify API token (Get from https://console.apify.com/account/integrations)
APIFY_TOKEN=

# Apify Actor ID for economic calendar scraping
# Default tested actor: curious_coder/economic-calendar or trudax/economic-calendar
APIFY_ACTOR_ID=curious_coder/economic-calendar

# Tavily API Key for macro news and sentiment retrieval (https://tavily.com/)
TAVILY_API_KEY=

# Exa API Key (Optional secondary search provider)
EXA_API_KEY=

# Environment run mode: 'live' tries API calls first; 'offline' forces cached/reproducible data
RUN_MODE=live
